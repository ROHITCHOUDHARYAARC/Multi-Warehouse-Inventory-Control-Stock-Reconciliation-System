{
  "info": {"name":"Multi-Warehouse Inventory System","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl","value":"http://localhost:8080"},{"key":"accessToken","value":""},{"key":"userId","value":""}],
  "item": [
    {"name":"Authentication","item":[
      {"name":"Login","event":[{"listen":"test","script":{"exec":["const body = pm.response.json(); if (body.success) pm.collectionVariables.set('accessToken', body.data.accessToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"<configured-admin-email>\",\n  \"password\": \"<password>\"\n}"},"url":"{{baseUrl}}/api/v1/auth/login"}},
      {"name":"Me","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/v1/auth/me"}},
      {"name":"Logout","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/v1/auth/logout"}}
    ]},
    {"name":"Users","item":[
      {"name":"List Users","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/v1/users?page=0&size=20"}},
      {"name":"Get User","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/v1/users/{{userId}}"}},
      {"name":"Create User","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"new.user\",\n  \"email\": \"new.user@example.com\",\n  \"password\": \"UseARealPassword1!\",\n  \"firstName\": \"New\",\n  \"lastName\": \"User\",\n  \"roleCodes\": [\"VIEWER\"]\n}"},"url":"{{baseUrl}}/api/v1/users"}},
      {"name":"Update User","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"new.user@example.com\",\"firstName\":\"New\",\"lastName\":\"User\"}"},"url":"{{baseUrl}}/api/v1/users/{{userId}}"}},
      {"name":"Activate User","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"ACTIVE\"}"},"url":"{{baseUrl}}/api/v1/users/{{userId}}/status"}},
      {"name":"Deactivate User","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"INACTIVE\"}"},"url":"{{baseUrl}}/api/v1/users/{{userId}}/status"}}
    ]},
    {"name":"Roles","item":[{"name":"List Roles","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/v1/roles"}},{"name":"Assign Role","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"roleCodes\":[\"VIEWER\"]}"},"url":"{{baseUrl}}/api/v1/users/{{userId}}/roles"}}]}
  ]
}
